{
	"schemaVersion": 1,
	"id": "dashieboard",
	"version": "${version}",
	"name": "Dashieboard",
	"description": "A lightweight Fabric mod for Minecraft servers, offering a unified HTTP API to enable real-time game data access for dashboards and external monitoring tools.",
	"authors": [
		"Oak Platinum"
	],
	"contact": {
		"homepage": "https://mln.hz6826.com.cn/",
		"sources": "https://github.com/OakPlatinum/Dashieboard"
	},
	"license": "MIT",
	"icon": "assets/dashieboard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.hz6826.dashieboard.Dashieboard"
		]
	},
	"mixins": [
		"dashieboard.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}